menu "Audio Front-End"

    config AUDIO_FE_MODEL_PARTITION
        string "Model partition label"
        default "model"
        help
            从该 data/spiffs 分区加载 ESP-SR 模型（见 partitions.csv）。

    config AUDIO_FE_INPUT_FORMAT
        string "AFE input format"
        default "M"
        help
            AFE 输入通道格式：M=单麦，MR=单麦+参考，MMR=双麦+参考。
            本期硬件为单麦（INMP441），固定 "M"。

    config AUDIO_FE_UPLINK_RING_MS
        int "Uplink ring depth (ms of 16k mono audio)"
        range 0 8000
        default 2000
        help
            上行 PCM 环形缓冲深度（16k/单声道/int16，放 PSRAM）。
            0 = 关闭上行接口（audio_fe_uplink_* 返回 ESP_ERR_NOT_SUPPORTED）。
            默认 2000ms → 32768 样本（2.048s，64KB PSRAM）：足够吸收编码/发送
            任务调度抖动，又能把上行时延限制在可接受范围（架构 §6.4 首帧 <200ms）。


    config AUDIO_FE_RESUME_DISCARD_MS
        int "恢复收音后丢弃的最早音频（毫秒，规则 R5）"
        range 0 200
        default 50
        help
            半双工规则 R5（ARCH §3.3）：打断恢复 feed 后，前 N 毫秒的麦克风数据喂零，
            避免打断瞬间的功放余响/开关噪声触发 VAD。voice_session 的 R4 打断路径用
            该值调用 audio_fe_feed_discard_ms()；正常 TTS 收尾走 R2 的 300ms 尾部延时，
            不使用 R5。

    config AUDIO_FE_AEC_ENABLE
        bool "启用软件参考 AEC（T4.4 C3 spike）"
        default n
        help
            开启后 audio_fe 在 feed 任务里用 esp_aec 处理麦克风：参考取自 audio_player
            的混音输出（post 音量/duck/限幅），无播放（speaker 未开）或 R1 hold 时旁路。
            caps 走 PSRAM；**量产默认关闭，需真实声学验证后再评估默认值**。

    choice AUDIO_FE_AEC_MODE
        prompt "AEC 模式"
        depends on AUDIO_FE_AEC_ENABLE
        default AUDIO_FE_AEC_MODE_SR_HIGH_PERF
        help
            SR_LOW_COST/SR_HIGH_PERF 面向唤醒；FD_LOW_COST 带 NLP，双讲更好但更重。
            实测（合成回声，内部 RAM/单帧）：SR filter=2 +6.4KB/0.81ms；
            SRH filter=2 +4.4KB/1.78ms；FD +12.7KB/6.9ms。

        config AUDIO_FE_AEC_MODE_SR_LOW_COST
            bool "SR_LOW_COST"
        config AUDIO_FE_AEC_MODE_SR_HIGH_PERF
            bool "SR_HIGH_PERF"
        config AUDIO_FE_AEC_MODE_FD_LOW_COST
            bool "FD_LOW_COST（双讲）"
    endchoice

    config AUDIO_FE_AEC_FILTER_LEN
        int "AEC filter_length"
        depends on AUDIO_FE_AEC_ENABLE
        range 1 8
        default 2
        help
            官方推荐 4；实测 2 的内部 RAM/CPU 约减半（+6.4KB/0.81ms @SR），
            但覆盖的延迟/混响更短，需真实声学验证（C3）。

    config AUDIO_FE_AEC_REF_DELAY_MS
        int "AEC 参考延迟（毫秒）"
        depends on AUDIO_FE_AEC_ENABLE
        range 0 300
        default 40
        help
            参考环读取相对播放写指针的延迟，用于对齐 DMA/功放/声学路径。
            真机按 ERLE/唤醒率扫描（runtime `aec delay <ms>`）。

    config AUDIO_FE_AEC_TTS_BARGEIN
        bool "TTS 播放期间保持开麦（AEC barge-in spike）"
        depends on AUDIO_FE_AEC_ENABLE
        default n
        help
            仅用于 T4.4 C4 spike：TTS 播放时**不 hold mic**，让 WakeNet 继续听，
            由 AEC 用 TTS 参考抵消自播；voice_session 只计数
            （`vs status` 的“TTS 中唤醒”），不真正打断。验证通过后再决定是否正式实现。

    config AUDIO_FE_AEC_BYPASS_WHEN_IDLE
        bool "无播放时旁路 AEC"
        depends on AUDIO_FE_AEC_ENABLE
        default y
        help
            speaker 未开（无音乐/TTS/提示音）时直接喂原始麦克风，保持现有安静
            环境唤醒基线；关闭后全程过 AEC（便于对比）。

endmenu
