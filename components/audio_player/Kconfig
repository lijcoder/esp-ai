menu "Audio Player"

    config AUDIO_PLAYER_DEFAULT_VOLUME
        int "Default volume (0-100)"
        range 0 100
        default 60

    config AUDIO_PLAYER_TAIL_DELAY_MS
        int "Tail delay after playback before done callback (ms)"
        default 300
        help
            播放结束后等待该时长再回调，用于吸收喇叭尾音（半双工规则 R2）。

    config AUDIO_PLAYER_ENABLE_MP3
        bool "启用 MP3 解码（T2.3，minimp3）"
        default y
        help
            TTS/音乐下行统一用 MP3（ARCH §3.7）。解码器为 vendored minimp3
            （third_party/minimp3，CC0），状态与临时区全部放 PSRAM，
            内部 RAM 增量 0（CONVENTIONS §4）。
            关闭后 audio_player_play_mp3() 返回 ESP_ERR_NOT_SUPPORTED，
            提示音（PCM）链路不受影响，固件体积减少约 40KB。

    config AUDIO_PLAYER_MP3_PCM_MAX_BYTES
        int "MP3 解码 PCM 缓冲上限（PSRAM，字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 524288
        range 65536 4194304
        help
            整段解码路径（audio_player_play_mp3）把整段解成单声道 PCM 放在这块
            预分配缓冲里（播放任务内禁止 malloc）。T2.4 流式播放不走这里，
            512KB ≈ 24k 单声道 10.9s；超长整段素材会被拒绝并打 WARN。

    config AUDIO_PLAYER_STREAM_RING_BYTES
        int "流式播放 PSRAM 压缩数据 ring（字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 65536
        range 8192 1048576
        help
            T2.4 流式播放：voice_cloud 把下行 MP3 字节写入这块 PSRAM ring，
            player 任务边收边解。64KB ≈ 24k/64kbps 约 8s 缓冲。

    config AUDIO_PLAYER_STREAM_PREROLL_FRAMES
        int "流式起播最少已解码帧数"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 4
        range 1 32
        help
            解出该帧数就起播（24kHz 单帧 24ms），与 PREROLL_MS 取先到者。
            首帧到出声 <150ms 是 P2 验收项。

    config AUDIO_PLAYER_STREAM_PREROLL_MS
        int "流式起播超时（距首个 write，毫秒）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 120
        range 10 2000
        help
            即使还没解够 PREROLL_FRAMES 帧，距首字节超过该时长也起播，
            避免弱网/小帧流迟迟不出声。


    config AUDIO_PLAYER_MUSIC_RING_MS
        int "音乐 PCM ring 时长（毫秒，48k 单声道）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 1000
        range 200 4000
        help
            T4.1：music_http 任务解码出的 48k PCM 先写这块 PSRAM ring，
            由混音级按 10ms 块搬进 CH_MUSIC。1000ms 覆盖 WiFi 抖动；
            越大越抗抖，但 PSRAM 占用 = 48k × 2B × ms。

    config AUDIO_PLAYER_MUSIC_URL_MAX
        int "音乐 URL 最大长度（字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 320
        range 64 1024
        help
            music_http 任务保存 URL 的静态缓冲。URL 来自服务端 music_track，
            端侧只做 http(s) 前缀与长度校验；超长直接拒绝（不截断）。

    config AUDIO_PLAYER_MUSIC_TASK_STACK
        int "music_http 任务栈（字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 6144
        range 4096 12288
        help
            T4.1 拉流任务（HTTP/TLS + MP3 解码 + 重采样）。任务按需创建，
            停止后销毁；栈在任务存活期占内部 RAM，所以不要随意加大。

    config AUDIO_PLAYER_MUSIC_HTTP_TIMEOUT_MS
        int "音乐 HTTP 读超时（毫秒）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 2000
        range 500 10000
        help
            esp_http_client 的连接/读超时。停止时任务最多阻塞这么久后退出。

    config AUDIO_PLAYER_MUSIC_PREFILL_MS
        int "音乐起播预缓冲（毫秒，48k 单声道）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 200
        range 50 1000
        help
            T4.5：起播前先解出至少该时长的 PCM 再进混音，避免起播空 ring 欠载。
            T4.1/T4.3 为 150ms；T4.5 提到 200ms（真机首声仍目标 <1.5s）。

    config AUDIO_PLAYER_MUSIC_RECONNECT_MAX
        int "音乐断流重连次数（每次断流）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 3
        range 0 10
        help
            T4.5：HTTP 读失败/服务端提前关闭时，用 Range 从上次字节偏移续播，
            最多重试该次数（含首次重连）；0=不重连（回退到 T4.1 行为）。

    config AUDIO_PLAYER_MUSIC_RECONNECT_BACKOFF_MS
        int "音乐重连退避（毫秒，线性递增）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 300
        range 50 2000
        help
            第 n 次重连前等待 n × 该值；暂停期间不重连（恢复后再试）。

    config AUDIO_PLAYER_INTERRUPT_FADE_MS
        int "按键打断淡出时长（毫秒，规则 R4）"
        range 20 100
        default 80
        help
            audio_player_fade_out_and_stop() 的默认时长（voice_session 的 R4 打断用它）。
            P3 验收口径是"按键打断 <100ms 停声"：80ms 淡出 + 一块 10ms 输出块 + 事件投递
            余量，T3.2/T3.3 真机实测 last_stop_ms 64~84ms。改大就必然超线，不要为了听感调大。

    config AUDIO_PLAYER_DUCK_DB
        int "音乐 duck 深度（dB，规则 R3）"
        range 3 30
        default 12
        help
            R3：音乐播放中唤醒，音乐在 100ms 内 duck 到该深度（相对当前音量的增益）。
            架构定稿 -12dB，约 0.25 倍振幅。

    config AUDIO_PLAYER_DUCK_RAMP_MS
        int "通道增益/duck 斜坡时长（毫秒）"
        range 10 500
        default 100
        help
            R3 的"100ms 内 duck 到 -12dB"由它保证：CH_MUSIC 的 q16 通道增益按该时长
            线性走到目标（T3.3 起 duck 是通道增益，不再压整个输出）。仅当目标变化时
            按本时长重算一次步进（块内逐样本推进），不要改成每块按剩余差重算。

endmenu
