menu "Audio Player"

    config AUDIO_PLAYER_DEFAULT_VOLUME
        int "Default volume (0-100)"
        range 0 100
        default 60

    config AUDIO_PLAYER_TAIL_DELAY_MS
        int "Tail delay after playback before done callback (ms)"
        default 300
        help
            播放结束后等待该时长再回调，用于吸收喇叭尾音（半双工规则 R2）。

    config AUDIO_PLAYER_ENABLE_MP3
        bool "启用 MP3 解码（T2.3，minimp3）"
        default y
        help
            TTS/音乐下行统一用 MP3（ARCH §3.7）。解码器为 vendored minimp3
            （third_party/minimp3，CC0），状态与临时区全部放 PSRAM，
            内部 RAM 增量 0（CONVENTIONS §4）。
            关闭后 audio_player_play_mp3() 返回 ESP_ERR_NOT_SUPPORTED，
            提示音（PCM）链路不受影响，固件体积减少约 40KB。

    config AUDIO_PLAYER_MP3_PCM_MAX_BYTES
        int "MP3 解码 PCM 缓冲上限（PSRAM，字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 524288
        range 65536 4194304
        help
            整段解码路径（audio_player_play_mp3）把整段解成单声道 PCM 放在这块
            预分配缓冲里（播放任务内禁止 malloc）。T2.4 流式播放不走这里，
            512KB ≈ 24k 单声道 10.9s；超长整段素材会被拒绝并打 WARN。

    config AUDIO_PLAYER_STREAM_RING_BYTES
        int "流式播放 PSRAM 压缩数据 ring（字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 65536
        range 8192 1048576
        help
            T2.4 流式播放：voice_cloud 把下行 MP3 字节写入这块 PSRAM ring，
            player 任务边收边解。64KB ≈ 24k/64kbps 约 8s 缓冲。

    config AUDIO_PLAYER_STREAM_PREROLL_FRAMES
        int "流式起播最少已解码帧数"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 4
        range 1 32
        help
            解出该帧数就起播（24kHz 单帧 24ms），与 PREROLL_MS 取先到者。
            首帧到出声 <150ms 是 P2 验收项。

    config AUDIO_PLAYER_STREAM_PREROLL_MS
        int "流式起播超时（距首个 write，毫秒）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 120
        range 10 2000
        help
            即使还没解够 PREROLL_FRAMES 帧，距首字节超过该时长也起播，
            避免弱网/小帧流迟迟不出声。


    config AUDIO_PLAYER_INTERRUPT_FADE_MS
        int "按键打断淡出时长（毫秒，规则 R4）"
        range 20 100
        default 80
        help
            audio_player_fade_out_and_stop() 的默认时长（voice_session 的 R4 打断用它）。
            P3 验收口径是"按键打断 <100ms 停声"：80ms 淡出 + 一块 10ms 输出块 + 事件投递
            余量，实测 last_stop_ms 应在 80~95ms。改大就必然超线，不要为了听感调大。

    config AUDIO_PLAYER_DUCK_DB
        int "音乐 duck 深度（dB，规则 R3）"
        range 3 30
        default 12
        help
            R3：音乐播放中唤醒，音乐在 100ms 内 duck 到该深度（相对当前音量的增益）。
            架构定稿 -12dB，约 0.25 倍振幅。

    config AUDIO_PLAYER_DUCK_RAMP_MS
        int "duck 斜坡时长（毫秒）"
        range 10 500
        default 100
        help
            R3 的"100ms 内 duck 到 -12dB"由它保证：q8 增益按该时长线性走到目标。

endmenu
