menu "Audio Player"

    config AUDIO_PLAYER_DEFAULT_VOLUME
        int "Default volume (0-100)"
        range 0 100
        default 60

    config AUDIO_PLAYER_TAIL_DELAY_MS
        int "Tail delay after playback before done callback (ms)"
        default 300
        help
            播放结束后等待该时长再回调，用于吸收喇叭尾音（半双工规则 R2）。

    config AUDIO_PLAYER_ENABLE_MP3
        bool "启用 MP3 解码（T2.3，minimp3）"
        default y
        help
            TTS/音乐下行统一用 MP3（ARCH §3.7）。解码器为 vendored minimp3
            （third_party/minimp3，CC0），状态与临时区全部放 PSRAM，
            内部 RAM 增量 0（CONVENTIONS §4）。
            关闭后 audio_player_play_mp3() 返回 ESP_ERR_NOT_SUPPORTED，
            提示音（PCM）链路不受影响，固件体积减少约 40KB。

    config AUDIO_PLAYER_MP3_PCM_MAX_BYTES
        int "MP3 解码 PCM 缓冲上限（PSRAM，字节）"
        depends on AUDIO_PLAYER_ENABLE_MP3
        default 1572864
        range 65536 4194304
        help
            播放任务解码 MP3 时把整段解成单声道 PCM 放在这块预分配缓冲里
            （播放任务内禁止 malloc）。1.5MB ≈ 24k 单声道 32s / 44.1k 单声道 17s；
            超长素材会被拒绝并打 WARN。

endmenu
