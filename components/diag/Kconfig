menu "Diagnostics"

    config DIAG_HEAP_MONITOR
        bool "周期堆水位监控任务"
        default n
        help
            建一个低优先级任务，按固定间隔打印内部 RAM / PSRAM 的水位。
            供 P5 长稳压测（T5.3）观察堆是否单调下降；默认关闭，避免污染常规日志。

    config DIAG_HEAP_MONITOR_INTERVAL_S
        int "堆水位打印间隔（秒）"
        depends on DIAG_HEAP_MONITOR
        range 5 3600
        default 30

    config DIAG_ENABLE_CRASH_TEST
        bool "启用 sys crash 崩溃测试命令（仅开发期）"
        default n
        help
            编译进 `sys crash` 子命令，主动触发 panic 以验证 coredump 分区
            是否能正常落盘、能否用 `idf.py coredump-info` 解析。
            **量产固件必须关闭**（默认 n，sdkconfig.defaults 里显式开启仅供开发板）。

    config DIAG_ENABLE_PLAYER_TEST
        bool "启用 player MP3 播放探针（仅开发期）"
        default n
        help
            编译进 `player` 命令：`player load begin/chunk/end` 把 PC 侧准备好的
            MP3（base64 分块，存 PSRAM）传到设备，`player mp3` 交给播放任务解码播放，
            `player stat` 打印解码/播放统计。用于 T2.3 验收（素材含真实电台码流）。
            **量产固件必须关闭**（默认 n，sdkconfig.defaults 里显式开启仅供开发板）。
            开启时 console 行缓冲 128 → 1024 B（约 +1KB 内部堆），上传才不至于太慢。

    config DIAG_PLAYER_TEST_MAX_BYTES
        int "player 探针的 MP3 上传缓冲上限（PSRAM，字节）"
        depends on DIAG_ENABLE_PLAYER_TEST
        default 524288
        range 16384 2097152

    config DIAG_ENABLE_AEC_TEST
        bool "启用 AEC spike 探针（仅开发期，T4.4b）"
        default n
        help
            编译进 `aec test [sr|fd] [psram|internal] [frames]`：创建一个 esp_aec 实例，
            用合成参考/回声跑 ERLE 与单帧耗时，并打印内部 RAM/PSRAM 增量。
            用于 PD-007 的 AEC 可行性评估（内存/CPU/算法基本正确性）。
            **量产固件必须关闭**（默认 n；本地 sdkconfig 临时开启）。

endmenu
