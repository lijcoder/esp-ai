# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
# 自定义分区
CONFIG_PARTITION_TABLE_CUSTOM=y
# 开启 16M FLASH
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 开启 8M PSRAM
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CPU 和缓存配置
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# WiFi/IP 事件在系统事件任务里回调（net_mgr 的处理器也在这里），
# 默认 2304 B 实测只剩 380 B，重新连接/断线日志格式化容易踩栈，加到 4096 B
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# SNTP：联网成功（GOT_IP）立即对时，关掉 lwIP 首次请求的随机启动延迟（最多 5s）
# TLS 校验证书前必须有可信时间，T1.3 实测对时从最坏 33s 降到地址就绪后 ~40ms
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set
# 开发 SR 语音功能
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9_HILEXIN=y
CONFIG_SPIRAM=y
# diag 的 sys tasks：任务枚举要 trace facility，CPU 占用要运行统计
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
# 崩溃现场落 coredump 分区（ARCH §9.1 / CONVENTIONS §8：idf.py coredump 解析）
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 开发期：sys crash 用于验证 coredump 落盘/解析；量产固件必须关闭
CONFIG_DIAG_ENABLE_CRASH_TEST=y

# T1.4（PRODUCT_IDEAS §8 X3 方案 A/B）：WS + TLS 要占用内部 RAM，
# T1.3 基线空闲堆只剩 79KB、最大连续块 31.7KB，按 X3 先做两件低风险裁剪：
# A. WiFi 静态 RX 缓冲 10→6（上行 4KB/s、下行 3KB/s 的小流量足够，省约 6.4KB）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# 注：动态 RX/TX 缓冲 32→16 在 T1.4 实测对 TLS 峰值没有改善（动态缓冲按需分配），
# 因此保持 IDF 默认值不引入未验证偏差；内部 RAM 余量的统一优化按 X3 在 P2 前做
# B. TLS 记录缓冲 16K/4K → 8K/2K（音频走二进制帧、JSON 帧很小，省约 10KB 握手期堆）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
