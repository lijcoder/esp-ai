# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
# 自定义分区
CONFIG_PARTITION_TABLE_CUSTOM=y
# 开启 16M FLASH
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 开启 8M PSRAM
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CPU 和缓存配置
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# WiFi/IP 事件在系统事件任务里回调（net_mgr 的处理器也在这里），
# 默认 2304 B 实测只剩 380 B，重新连接/断线日志格式化容易踩栈，加到 4096 B
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# SNTP：联网成功（GOT_IP）立即对时，关掉 lwIP 首次请求的随机启动延迟（最多 5s）
# TLS 校验证书前必须有可信时间，T1.3 实测对时从最坏 33s 降到地址就绪后 ~40ms
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set
# 开发 SR 语音功能
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9_HILEXIN=y
CONFIG_SPIRAM=y
# diag 的 sys tasks：任务枚举要 trace facility，CPU 占用要运行统计
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
# 崩溃现场落 coredump 分区（ARCH §9.1 / CONVENTIONS §8：idf.py coredump 解析）
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 开发期：sys crash 用于验证 coredump 落盘/解析；量产固件必须关闭
CONFIG_DIAG_ENABLE_CRASH_TEST=y

# T1.4（PRODUCT_IDEAS §8 X3 方案 A/B）：WS + TLS 要占用内部 RAM，
# T1.3 基线空闲堆只剩 79KB、最大连续块 31.7KB，按 X3 先做两件低风险裁剪：
# A. WiFi 静态 RX 缓冲 10→6（上行 4KB/s、下行 3KB/s 的小流量足够，省约 6.4KB）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# 注：动态 RX/TX 缓冲 32→16 在 T1.4 实测对 TLS 峰值没有改善（动态缓冲按需分配），
# 因此保持 IDF 默认值不引入未验证偏差；内部 RAM 余量的统一优化按 X3 在 P2 前做
# B. TLS 记录缓冲 16K/4K → 8K/2K（音频走二进制帧、JSON 帧很小，省约 10KB 握手期堆）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# X3-F（2026-10-31）：只把 mbedTLS 的堆（TLS 记录缓冲 8K+2K + 握手期证书/DHM 解析）搬到 PSRAM，
# WiFi/lwIP 的驱动缓冲与数据路径保持内部 RAM —— 不引入 PSRAM 拷贝时延（PRODUCT_IDEAS §8 X3-F）。
# 实测：wss 握手期内部 RAM 最低水位 25,087 → 47,051~52,839 B；TLS 握手耗时 / boot→NET_UP 无劣化。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# T2.2（codec_enc）：上行 Opus 编码走 microOpus（esphome/micro-opus 0.4.1）。
# 它的 Ogg 解容器是 C++；IDF 5.x 的 C++ 支持默认编入（无 COMPILER_CXX 开关），无需额外配置
# 编码器状态与临时内存（伪栈）全部放 PSRAM：内部 RAM 只剩约 16KB 硬余量
# （CONVENTIONS §4；libopus 固定点在栈上要 ~10KB，直接放任务栈会超预算）
CONFIG_OPUS_STATE_PREFER_PSRAM=y
CONFIG_OPUS_PSEUDOSTACK_PREFER_PSRAM=y
# 伪栈模式：保持 microOpus 默认的 thread-safe 版（C11 _Thread_local + pthread TLS）。
# T2.2 实测它在 FreeRTOS 任务（console/voice_cloud，非 pthread）里工作正常，
# 每个调用线程独立 120KB PSRAM 伪栈（本工程最多 2 个），换来"可并发调用"的安全性。
# 注：曾误判为 TLS 崩溃 —— 实际是浮点实现的问题（见下面 FLOATING_POINT 注释）。
# 伪栈 120KB/线程：16k/单声道/20ms 编码实际约 25~30KB，先按默认留余量；
# T2.2 实测 PSRAM 余 7.5MB，若要压缩再下调（Kconfig 范围下限 60000）
CONFIG_OPUS_PSEUDOSTACK_SIZE=120000
# 定点实现（T2.2 实测）：浮点实现（S3 默认 y）在本工程首次编码即崩溃 ——
# nonthreadsafe+float 报 MMU fault（silk_noise_shape_quantizer_del_dec 访问 PSRAM
# 伪栈 invalid mmu entry）；threadsafe+float 报 LoadProhibited（EXCVADDR 0x44）。
# 改成定点后两种伪栈模式都正常；S3 上定点 CPU 更省，选定点（详见 STATUS T2.2 排查记录）
# CONFIG_OPUS_FLOATING_POINT is not set
CONFIG_OPUS_ENABLE_XTENSA_OPTIMIZATIONS=y
# 编码器参数（codec_enc 的 Kconfig）显式写死，避免 sdkconfig 重生成时回默认
CONFIG_CODEC_ENC_BITRATE=16000
CONFIG_CODEC_ENC_VBR=y
CONFIG_CODEC_ENC_COMPLEXITY=3
